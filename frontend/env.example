# Flask Backend Environment Variables
# Copy this file to .env and fill in your values

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False

# Server Configuration
PORT=5000
HOST=0.0.0.0

# CORS Settings (allow frontend domain)
CORS_ORIGINS=*

# Model Paths (relative to app.py)
M1_MODEL_PATH=M1_collar_model.joblib
M2_MODEL_PATH=M2_plant_model.tflite
M2_METADATA_PATH=M2_plant_model.json
